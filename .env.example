# LLM provider (LangChain chat model interface — swap provider without touching code)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Data paths (defaults shown; usually no need to change these locally)
CATEGORY_INSIGHTS_DB_PATH=data/warehouse.duckdb
CATEGORY_INSIGHTS_CHROMA_DIR=data/chroma

# Category resolution confidence thresholds (0.0-1.0 similarity)
CATEGORY_INSIGHTS_RESOLUTION_HIGH_THRESHOLD=0.75
CATEGORY_INSIGHTS_RESOLUTION_MEDIUM_THRESHOLD=0.5

# Minimum similarity for a retrieved note to be considered relevant
CATEGORY_INSIGHTS_NOTE_MIN_SIMILARITY=0.3

# Absolute percentage-point delta that auto-triggers note retrieval
# even when the user didn't explicitly ask "why"
CATEGORY_INSIGHTS_UNEXPECTED_DELTA_THRESHOLD=10.0

# Fixed seed for reproducible mock-data generation (keeps generated events
# in sync with the curated notes fixture)
CATEGORY_INSIGHTS_MOCK_DATA_SEED=42
